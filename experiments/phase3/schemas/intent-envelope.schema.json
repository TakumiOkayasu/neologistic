{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:neologistic:phase3:intent-envelope:v1",
  "title": "IntentEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "user_request",
    "contract",
    "provenance",
    "side_effects",
    "non_goals"
  ],
  "properties": {
    "version": {
      "const": "intent-v1"
    },
    "user_request": {
      "type": "string",
      "minLength": 1
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "acceptance_criteria"
      ],
      "properties": {
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "criterion",
              "source_intent_ids"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "criterion": {
                "type": "string",
                "minLength": 1
              },
              "source_intent_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_authorized",
        "assistant_inference",
        "external_evidence"
      ],
      "properties": {
        "user_authorized": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/intentItem"
          }
        },
        "assistant_inference": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/intentItem"
          }
        },
        "external_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/intentItem"
          }
        }
      }
    },
    "side_effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "forbidden"
      ],
      "properties": {
        "allowed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "intentItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
