{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:neologistic:phase3:run-manifest:v2",
  "title": "Phase3RunManifestV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "scope",
    "run_id",
    "freeze_lock_sha256",
    "sender",
    "receiver",
    "transport",
    "isolation",
    "elimination_policy",
    "execution_order",
    "runtime_retries_fixed"
  ],
  "properties": {
    "version": {
      "const": "phase3-run-manifest-v2"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "freeze_lock_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sender": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "reasoning_effort",
        "temperature",
        "max_output_tokens"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "reasoning_effort": {
          "type": "string",
          "minLength": 1
        },
        "temperature": {
          "type": [
            "number",
            "null"
          ]
        },
        "max_output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "receiver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "reasoning_effort",
        "temperature",
        "max_output_tokens"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "reasoning_effort": {
          "type": "string",
          "minLength": 1
        },
        "temperature": {
          "type": [
            "number",
            "null"
          ]
        },
        "max_output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "transport": {
      "type": "string",
      "minLength": 1
    },
    "execution_order": {
      "type": "array",
      "minItems": 48,
      "maxItems": 48,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "arm_id"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^p3-[0-9]{3}$"
          },
          "arm_id": {
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "E",
              "F"
            ]
          }
        }
      }
    },
    "runtime_retries_fixed": {
      "type": "integer",
      "minimum": 0
    },
    "scope": {
      "const": "semantic-transfer-pilot-v1"
    },
    "elimination_policy": {
      "const": "after-first-hard-failure"
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace",
        "repository_access",
        "tools",
        "plugins_enabled",
        "memory_enabled",
        "network"
      ],
      "properties": {
        "workspace": {
          "const": "empty-temporary"
        },
        "repository_access": {
          "const": false
        },
        "tools": {
          "type": "array",
          "maxItems": 0
        },
        "plugins_enabled": {
          "const": false
        },
        "memory_enabled": {
          "const": false
        },
        "network": {
          "const": "provider-only"
        }
      }
    }
  }
}
