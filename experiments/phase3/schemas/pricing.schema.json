{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:neologistic:phase3:pricing:v2",
  "title": "Phase3PricingPolicyV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "currency",
    "entries"
  ],
  "properties": {
    "version": {
      "const": "phase3-pricing-v2"
    },
    "currency": {
      "const": "USD"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "model",
          "uncached_input_nano_per_token",
          "cached_input_nano_per_token",
          "cache_write_input_nano_per_token",
          "output_nano_per_token",
          "reasoning_included_in_output",
          "max_input_tokens_per_call",
          "source",
          "verified_at"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "uncached_input_nano_per_token": {
            "type": "integer",
            "minimum": 0
          },
          "cached_input_nano_per_token": {
            "type": "integer",
            "minimum": 0
          },
          "cache_write_input_nano_per_token": {
            "type": "integer",
            "minimum": 0
          },
          "output_nano_per_token": {
            "type": "integer",
            "minimum": 0
          },
          "reasoning_included_in_output": {
            "const": true
          },
          "max_input_tokens_per_call": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "verified_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
